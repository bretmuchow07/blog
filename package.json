{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply blog-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog-db --remote",
    "db:seed:local": "wrangler d1 execute blog-db --local --file=./drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute blog-db --remote --file=./drizzle/seed.sql"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.4.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^2.3.2",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "diff": "^9.0.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "wrangler": "^4.157.0"
  }
}
