# Site URL configuration
NEXT_PUBLIC_SITE_URL=https://blog.bretmuchoni.dev
NEXT_PUBLIC_PORTFOLIO_URL=https://bretmuchoni.dev

# Administrator Authentication
# Strong password used to authenticate into the /admin portal
ADMIN_PASSWORD=replace-with-a-strong-random-password

# Dedicated HMAC session signing secret (recommended: 32+ cryptographically random bytes)
# If omitted, ADMIN_PASSWORD is used as the signing key
ADMIN_SESSION_SECRET=replace-with-a-random-secret-key-for-session-signing
